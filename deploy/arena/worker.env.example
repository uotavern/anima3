# /etc/uoarena/public-mage.env (mode 0600)
ARENA_USER=arena_bot_mage
ARENA_BOT_PASSWORD=replace-with-a-unique-password
ARENA_WORKER_ARGS="--build mage --policy /var/lib/uoarena/policies/champion.json"

# Public warrior: --build warrior (no mage policy file)
# Training reference: --training --build mage --policy /var/lib/uoarena/policies/champion.json
# Training challenger: --training --build mage --curriculum /var/lib/uoarena/policies
# Use a different allowlisted account and a separate env file for every worker.
