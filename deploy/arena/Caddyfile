# /etc/caddy/Caddyfile on the arena host. Needs TCP 80 and 443 open in the Linode
# cloud firewall (80 for the Let's Encrypt HTTP-01 challenge and the https redirect).
# The game itself stays on direct TCP 2593; Caddy only serves the web side.
arena.uotavern.com {
	encode gzip

	# The shard's read-only duel feed (ServUO DuelWeb, Duel.cfg).
	handle /duel/* {
		# Mono's HttpListener only answers the host it is bound to.
		reverse_proxy 127.0.0.1:8095 {
			header_up Host 127.0.0.1:8095
		}
	}

	# Everything else goes to the Tavern's duel page, which reads the feed above.
	handle {
		redir https://www.uotavern.com/forum/duels 302
	}
}
